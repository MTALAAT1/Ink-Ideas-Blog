<%-include("partials/header.ejs") %>
<section class="edit">
    <form action="/edit/save" method="POST">
  <div class="title">
    <textarea
      class="titleText"
      name="Title"
      placeholder="Type your title here..."
    ><%= post.title %></textarea>
  </div>
  <div class="editPost">
    <textarea name="Body" class="bodyText" placeholder="Type your text here...">
        <%=post.body %>
    </textarea>

    <div class="d-flex justify-content-end me-5">
      <button type="submit" name="postIndexForSaving" value="<%=index  %>" class="deleteButton">Post</button>

    </div>
    </form>
  </div>
</section>

<%-include("partials/footer.ejs") %>
